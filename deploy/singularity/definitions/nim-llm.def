Bootstrap: docker
From: nvcr.io/nim/nvidia/llama-3.3-nemotron-super-49b-v1.5:1.14.0

%help
    NIM LLM - Llama 3.3 Nemotron Super 49B v1.5
    Official image: nvcr.io/nim/nvidia/llama-3.3-nemotron-super-49b-v1.5:1.14.0

    Matches version from docker-compose (deploy/compose/nims.yaml)

    This definition preserves the NIM container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 1.14.0
    Description NIM LLM for RAG generation (49B model)

%environment
    # LLM NIM uses nim_llm_sdk stack (same family as VLM).
    # Port is set via --port 8999 in %startscript (start_server.sh "$@" passthrough).
    # NIM_SERVER_PORT: argparse default only, not forwarded to api_server.py via os.execvpe.

%startscript
    # Pass --port 8999 directly to start_server.sh.
    # start_server.sh calls: python3 -m nim_llm_sdk.entrypoints.launch "$@"
    # The "$@" forwards all args → launch.py → cli_args → api_server.py --port 8999
    # Docker Compose maps host:8999 → container:8000; Singularity has no port mapping.
    exec /opt/nim/start_server.sh --port 8999
