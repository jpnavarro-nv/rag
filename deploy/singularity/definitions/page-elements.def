Bootstrap: docker
From: nvcr.io/nim/nvidia/nemoretriever-page-elements-v2:1.5.0

%help
    NIM Page Elements Detection (YOLOX) v2
    Official image: nvcr.io/nim/nvidia/nemoretriever-page-elements-v2:1.5.0

    Matches version from docker-compose (deploy/compose/nims.yaml)

    This definition preserves the Triton NIM container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 1.5.0
    Description NIM YOLOX model for page layout element detection

%environment
    # Triton-based NIM: port configured via NIM_HTTP_API_PORT.
    # Docker Compose maps host:8000 → container:8000. No port change needed for Singularity,
    # but set explicitly for consistency with other Triton NIMs.
    export NIM_HTTP_API_PORT=8000

# No %startscript: Apptainer falls back to %runscript (Docker CMD/ENTRYPOINT),
# which starts the Triton Inference Server with NIM_HTTP_API_PORT from %environment.
