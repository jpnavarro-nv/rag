Bootstrap: docker
From: milvusdb/milvus:v2.6.2-gpu

%help
    Milvus Vector Database (GPU-enabled)
    Official image: milvusdb/milvus:v2.6.2-gpu

    Matches version from docker-compose (deploy/compose/vectordb.yaml)

    This custom Singularity definition adds a %startscript to enable
    'singularity instance start' for background service execution.

    Usage:
        singularity instance start \
          --nv \
          --env ETCD_ENDPOINTS=localhost:2379 \
          --env MINIO_ADDRESS=localhost:9010 \
          --env "KNOWHERE_GPU_MEM_POOL_SIZE=2048;4096" \
          --bind /data/milvus:/var/lib/milvus \
          milvus.sif \
          milvus-instance \
          run standalone

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version v2.6.2-gpu
    Description Milvus GPU-enabled vector database with Singularity startscript

%startscript
    # This script is executed when using 'singularity instance start'
    # All arguments passed to instance start are available as $@
    exec /usr/bin/milvus "$@"
