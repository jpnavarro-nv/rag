Bootstrap: docker
From: nvcr.io/nim/nvidia/llama-3.2-nv-rerankqa-1b-v2:1.8.0

%help
    NIM Ranking Model - Llama 3.2 NV RerankQA 1B v2
    Official image: nvcr.io/nim/nvidia/llama-3.2-nv-rerankqa-1b-v2:1.8.0

    Matches version from docker-compose (deploy/compose/nims.yaml)

    This definition preserves the NIM container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 1.8.0
    Description NIM Ranking Model for RAG reranking

%environment
    # Triton-based NIM: port configured via NIM_HTTP_API_PORT.
    # Docker Compose maps host:1976 → container:8000. In Singularity (host network),
    # the container must bind directly on port 1976.
    export NIM_HTTP_API_PORT=1976

# No %startscript: Apptainer falls back to %runscript (Docker CMD/ENTRYPOINT),
# which starts the Triton Inference Server with NIM_HTTP_API_PORT from %environment.
