Bootstrap: docker
From: nvcr.io/nvidia/nemo-microservices/nv-ingest:25.9.0

%help
    NV-Ingest Microservice v25.9.0
    Official image: nvcr.io/nvidia/nemo-microservices/nv-ingest:25.9.0

    Matches version from docker-compose (deploy/compose/docker-compose-ingestor-server.yaml)

    This definition preserves the NV-Ingest container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 25.9.0
    Description NV-Ingest Ray-based document processing microservice

%startscript
    # NV-Ingest uses its built-in entrypoint/cmd from the Docker image
    # This startscript executes the default behavior
    exec "$@"
