Bootstrap: docker
From: nvcr.io/nim/nvidia/llama-3.2-nv-embedqa-1b-v2:1.10.1

%help
    NIM Embedding Model - Llama 3.2 NV EmbedQA 1B v2
    Official image: nvcr.io/nim/nvidia/llama-3.2-nv-embedqa-1b-v2:1.10.1

    Matches version from docker-compose (deploy/compose/nims.yaml)

    This definition preserves the NIM container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 1.10.1
    Description NIM Embedding Model for RAG retrieval

%environment
    # Triton-based NIM: port configured via NIM_HTTP_API_PORT.
    # Docker Compose maps host:9080 → container:8000. In Singularity (host network),
    # the container must bind directly on port 9080.
    export NIM_HTTP_API_PORT=9080

# No %startscript: Apptainer falls back to %runscript (Docker CMD/ENTRYPOINT),
# which starts the Triton Inference Server with NIM_HTTP_API_PORT from %environment.
