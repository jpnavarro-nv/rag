Bootstrap: docker
From: nvcr.io/nim/nvidia/nemoretriever-graphic-elements-v1:1.5.0

%help
    NIM Graphic Elements Detection (YOLOX) v1
    Official image: nvcr.io/nim/nvidia/nemoretriever-graphic-elements-v1:1.5.0

    Matches version from docker-compose (deploy/compose/nims.yaml)

    This definition preserves the Triton NIM container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 1.5.0
    Description NIM YOLOX model for graphic element detection

%environment
    # Triton-based NIM: port configured via NIM_HTTP_API_PORT.
    # Docker Compose maps host:8003 → container:8000. In Singularity (host network),
    # the container must bind directly on port 8003.
    export NIM_HTTP_API_PORT=8003

# No %startscript: Apptainer falls back to %runscript (Docker CMD/ENTRYPOINT),
# which starts the Triton Inference Server with NIM_HTTP_API_PORT from %environment.
