Bootstrap: docker
From: minio/minio:RELEASE.2025-02-28T09-55-16Z

%help
    MinIO High Performance Object Storage
    Official image: minio/minio:RELEASE.2025-02-28T09-55-16Z

    Matches version from docker-compose (deploy/workbench/compose.yaml)

    This custom Singularity definition adds a %startscript to enable
    'singularity instance start' for background service execution.

    Usage:
        singularity instance start \
          --env MINIO_ROOT_USER=minioadmin \
          --env MINIO_ROOT_PASSWORD=minioadmin \
          --bind /data/minio:/data \
          minio.sif \
          minio-instance \
          server /data --console-address :9011 --address :9010

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version RELEASE.2025-02-28T09-55-16Z
    Description MinIO object storage with Singularity startscript

%startscript
    # This script is executed when using 'singularity instance start'
    # All arguments passed to instance start are available as $@
    exec /usr/bin/minio "$@"
