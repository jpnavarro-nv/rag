Bootstrap: docker
From: nvcr.io/nim/nvidia/llama-3.1-nemotron-nano-vl-8b-v1:1.3.1

%help
    NIM VLM - Llama 3.1 Nemotron Nano VL 8B v1
    Official image: nvcr.io/nim/nvidia/llama-3.1-nemotron-nano-vl-8b-v1:1.3.1

    Matches version from docker-compose (deploy/compose/nims.yaml)

    This definition preserves the NIM container's default startup behavior.

%labels
    Author NVIDIA RAG Blueprint - Singularity Deployment
    Version 1.3.1
    Description NIM Vision-Language Model for image captioning

%environment
    # Port is set via --port 1977 in %startscript (start_server.sh "$@" passthrough).
    # NIM_HTTP_API_PORT: Triton-only, ignored here.
    # NIM_SERVER_PORT: argparse default only, not forwarded to api_server.py via os.execvpe.

%startscript
    # Pass --port 1977 directly to start_server.sh.
    # start_server.sh calls: python3 -m nim_llm_sdk.entrypoints.launch "$@"
    # The "$@" forwards all args → launch.py → cli_args → api_server.py --port 1977
    # This is the correct fix for Singularity (no Docker port mapping available).
    exec /opt/nim/start_server.sh --port 1977
