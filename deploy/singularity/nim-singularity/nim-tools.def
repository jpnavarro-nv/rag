Bootstrap: docker
From: python:3.12-slim

%files
    requirements.txt /requirements.txt

%post
    pip install --no-cache-dir \
        --trusted-host pypi.org \
        --trusted-host files.pythonhosted.org \
        -r /requirements.txt
    rm /requirements.txt

%labels
    Description NIM utility container (huggingface-cli, requests, openai)
