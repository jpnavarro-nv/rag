Bootstrap: docker
From: python:3.12-slim

%post
    pip install --no-cache-dir \
        huggingface-hub[cli] \
        requests \
        openai
    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export LC_ALL=C

%labels
    Description NIM utility container (huggingface-cli, requests, openai)
